# =============================================================================
# OpenTrace — Environment Configuration Template
# Copy to .env and fill in your values
# =============================================================================

# Database
TOKEN_DB_URL=postgresql://postgres:PASSWORD@postgres:5432/opentrace_v2
DATABASE_URL=postgresql://postgres:PASSWORD@postgres:5432/opentrace_v2

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=user@example.com

# Registration
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_EMAIL_DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
PASSWORD_PREFIX=your_prefix

# Redis
REDIS_URL=redis://localhost:6379/10
REDIS_SESSION_DB=10
REDIS_CACHE_DB=11
REDIS_MEMORY_DB=12
REDIS_QUEUE_DB=13
REDIS_RATE_LIMIT_DB=14
REDIS_PUBSUB_DB=15

# LLM - Query
DEFAULT_LLM_QUERY_PROVIDER=
DEFAULT_LLM_QUERY_MODEL=
DEFAULT_LLM_QUERY_BASE_URL=
DEFAULT_LLM_QUERY_API_KEY=

# LLM - Compress
DEFAULT_LLM_COMPRESS_PROVIDER=
DEFAULT_LLM_COMPRESS_MODEL=
DEFAULT_LLM_COMPRESS_BASE_URL=
DEFAULT_LLM_COMPRESS_API_KEY=

# LLM - Planning
DEFAULT_LLM_PLANING_PROVIDER=
DEFAULT_LLM_PLANING_MODEL=
DEFAULT_LLM_PLANING_BASE_URL=
DEFAULT_LLM_PLANING_API_KEY=

# LLM - SeniorShort (14B) — knowledge Q&A + lightweight critique
DEFAULT_LLM_SENIORSHORT_PROVIDER=
DEFAULT_LLM_SENIORSHORT_MODEL=qwen3-14b
DEFAULT_LLM_SENIORSHORT_BASE_URL=
DEFAULT_LLM_SENIORSHORT_API_KEY=

# LLM - MiddleShort (8B) — simple/FAQ direct answers
DEFAULT_LLM_MIDDLESHORT_PROVIDER=
DEFAULT_LLM_MIDDLESHORT_MODEL=qwen3-8b
DEFAULT_LLM_MIDDLESHORT_BASE_URL=
DEFAULT_LLM_MIDDLESHORT_API_KEY=

# LLM - JuniorShort (1.7B) — L1 one-shot classification
DEFAULT_LLM_JUNIORSHORT_PROVIDER=
DEFAULT_LLM_JUNIORSHORT_MODEL=qwen3-1.7b
DEFAULT_LLM_JUNIORSHORT_BASE_URL=
DEFAULT_LLM_JUNIORSHORT_API_KEY=

# LLM - MinShort (0.6B) — reserved for future use
DEFAULT_LLM_MINSHORT_PROVIDER=
DEFAULT_LLM_MINSHORT_MODEL=qwen3-0.6b
DEFAULT_LLM_MINSHORT_BASE_URL=
DEFAULT_LLM_MINSHORT_API_KEY=

# App
APP_NAME=opentrace
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_HOST=0.0.0.0
APP_PORT=14100
DEBUG=false

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Data source credential encryption
DATA_SECRET_KEY=change-me-in-production

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=14100
CORS_ALLOWED_ORIGINS=http://localhost:14108,http://127.0.0.1:14108
# Required when ENTERPRISE_TENANT_RLS_ENABLED=true. Trusted proxies sign
# X-Tenant-Id/X-Org-Id/X-Workspace-Id together with the authenticated user.
TRUSTED_TENANT_HEADER_SECRET=
TRUSTED_TENANT_HEADER_MAX_AGE_SECONDS=300

# Vector DB
USE_PGVECTOR=true

# Trace
TRACE_ENABLED=true
MAX_AGENT_STEPS=8
AGENT_TIMEOUT=120

# Orchestrator
# - 生产主路径：vNext（CognitiveKernel → CognitiveSupervisor → RuntimeGateway）
KERNEL_AGENT_TIMEOUT_SEC=25
KERNEL_AGENT_MAX_PARALLEL=5
KERNEL_AGENT_MAX_RETRY=1
KERNEL_AGENT_RUNTIME_SUPERVISOR_ENABLED=true
KERNEL_ANSWER_DRAFT_CONFIDENCE_THRESHOLD=0.75
KERNEL_ANSWER_DRAFT_MAX_CHARS=220
KERNEL_ADAPTIVE_MODE_ENABLED=true
KERNEL_ADAPTIVE_PROFILE_JSON={"speed":{"draft_threshold":0.68,"draft_max_chars":300},"balanced":{"draft_threshold":0.75,"draft_max_chars":220},"quality":{"draft_threshold":0.82,"draft_max_chars":160}}
KERNEL_PLAN_MEMORY_ENABLED=true
KERNEL_PLAN_MEMORY_WINDOW=50
KERNEL_MEMORY_CONTEXT_ENABLED=true
KERNEL_ENRICHED_IDENTITY_ENABLED=true
# 证据门禁（settings.rag_min_evidence_score）；遗留 RAG_MIN_SCORE 仅部分旧代码读取
RAG_MIN_EVIDENCE_SCORE=0.65
RAG_MIN_EVIDENCE_COUNT=2

# Retired V5 routing tombstones; keep false during rolling upgrades.
KERNEL_V5_ROUTING_ENABLED=false
KERNEL_L0_RULE_ROUTER_ENABLED=false
KERNEL_L1_TINY_ROUTER_ENABLED=false
KERNEL_SEMANTIC_CACHE_ENABLED=false
KERNEL_SEMANTIC_CACHE_THRESHOLD=0.92
KERNEL_SEMANTIC_CACHE_TTL_SECONDS=3600
KERNEL_SEMANTIC_CACHE_MAX_ENTRIES=10000
KERNEL_L1_ROUTER_MODEL=juniorshort
KERNEL_L1_FAST_ANSWER_MODEL=middleshort
KERNEL_L1_KNOWLEDGE_MODEL=seniorshort

# Enterprise control plane (multi-replica: enable Redis mirrors)
ENTERPRISE_QUOTA_REDIS_ENABLED=false
ENTERPRISE_USAGE_REDIS_ENABLED=false
ENTERPRISE_TENANT_RLS_ENABLED=false
ENTERPRISE_BILLING_PERSIST_ENABLED=false

# Text2SQL execution firewall
TEXT2SQL_DEFAULT_LIMIT=100
TEXT2SQL_MAX_RESULT_ROWS=500
TEXT2SQL_STATEMENT_TIMEOUT_MS=15000

# Dynamic skill code remains disabled until an isolated runner is configured.
SKILLS_GIT_INSTALL_ENABLED=false
SKILLS_LOCAL_CREATE_ENABLED=false
SKILLS_INPROCESS_EXECUTION_ENABLED=false

# Frontend
VITE_API_URL=http://localhost:14100
# Responses API v2 is the only public chat execution surface.
VITE_WS_URL=ws://localhost:14100
FRONTEND_PORT=14108

# Normal chat turns always require the primary answer model.  Deterministic
# checks still protect auth, quotas, safety and tool/SQL parameters.
KERNEL_ALL_QUESTIONS_REQUIRE_MODEL=true

# Embedding (DashScope qwen3-vl-embedding — multimodal semantic embeddings)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL_NAME=qwen3-vl-embedding
EMBEDDING_DIMS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# Rerank (DashScope qwen3-vl-rerank — neural reranker for retrieval precision)
RERANK_PROVIDER=dashscope
RERANK_MODEL_NAME=qwen3-vl-rerank
RERANK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=10
RAG_RERANK_ENABLED=true

# Web Search
SERPER_API_KEY=

# Web page fetch (disabled by default; managed environments require a domain allowlist)
WEB_FETCH_ENABLED=false
WEB_FETCH_ALLOWED_DOMAINS=
WEB_FETCH_TIMEOUT_SECONDS=10
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_MAX_RESPONSE_BYTES=1000000

# Connector OAuth callback boundary
CONNECTOR_ALLOWED_REDIRECT_ORIGINS=http://localhost:14108,http://127.0.0.1:14108
CONNECTOR_OAUTH_STATE_TTL_SECONDS=600

# Weather (OpenWeatherMap API — https://openweathermap.org/api)
WEATHER_API_KEY=

# Weather (Weatherstack API — https://weatherstack.com)
WEATHER_STACK_API_KEY=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=opentrace
OTEL_TRACES_SAMPLER=always_on

# Cognition lexicon (JSON list)
# Example:
# COGNITION_LEXICON_JSON=[{"canonical_name":"华北","entity_type":"region","aliases":["north china"],"mappings":{"sql":{"region":"华北"}}}]
COGNITION_LEXICON_JSON=

# =============================================================================
# Kernel V4 / Agent Runtime (legacy 区块 — 与上文不重复配置)
# =============================================================================
# Progressive draft answering
KERNEL_ANSWER_DRAFT_CONFIDENCE_THRESHOLD=0.75
KERNEL_ANSWER_DRAFT_MAX_CHARS=220

# RAG retrieval quality（权威变量见 RAG_MIN_EVIDENCE_SCORE）
LLMWIKI_ENABLED=true
LLMWIKI_MODEL=qwen3.5-27b
LLMWIKI_TOP_K=3
RAG_RERANK_ENABLED=true

# Attachment upload
ATTACHMENT_UPLOAD_ENABLED=true
ATTACHMENT_MAX_SIZE_MB=20
ATTACHMENT_STORAGE_PATH=/tmp/opentrace_attachments
ATTACHMENT_MAX_CHARS=4000
MULTIMODAL_ATTACHMENT_ENABLED=true

# =============================================================================
# DataAgent V2 — Cognitive Data Core
# =============================================================================
DATA_AGENT_V2_ENABLED=true
DATA_AGENT_V2_FALLBACK_TO_V1=false

# Knowledge Layer
KNOWLEDGE_ORCHESTRATION_ENABLED=true
KNOWLEDGE_QUERY_ENABLED=true
KNOWLEDGE_AUTO_COMPILE_ENABLED=true
KNOWLEDGE_AUTO_PUBLISH=true
KNOWLEDGE_MAX_RELATION_HOPS=2
KNOWLEDGE_QUERY_CANDIDATE_BUDGET=60
KNOWLEDGE_STALE_AFTER_DAYS=30
KNOWLEDGE_JOB_POLL_SECONDS=2
KNOWLEDGE_JOB_RECLAIM_MINUTES=10
DATA_AGENT_V2_KNOWLEDGE_RETRIEVER_ENABLED=true
DATA_AGENT_V2_USE_METRIC_DEFINITIONS=true
DATA_AGENT_V2_USE_SCHEMA_METADATA=true
DATA_AGENT_V2_USE_TABLE_RELATIONSHIPS=true
DATA_AGENT_V2_USE_ANALYTICAL_SKILLS=true

# Reasoning Layer Sub-Agents
DATA_AGENT_V2_INTENT_ENABLED=true
DATA_AGENT_V2_ENTITY_ENABLED=true
DATA_AGENT_V2_METRIC_ENABLED=true
DATA_AGENT_V2_TIME_ENABLED=true
DATA_AGENT_V2_JOIN_ENABLED=true
DATA_AGENT_V2_SEMANTIC_ENABLED=true
DATA_AGENT_V2_PLANNER_ENABLED=true
DATA_AGENT_V2_COMPILER_ENABLED=true
DATA_AGENT_V2_SQL_COMPILER_ENABLED=true
DATA_AGENT_V2_VERIFIER_ENABLED=true
DATA_AGENT_V2_REFLECTION_ENABLED=true
DATA_AGENT_V2_CRITIC_ENABLED=true

# DAG & Supervisor
DATA_AGENT_V2_DAG_PARALLEL_ENABLED=true
DATA_AGENT_V2_SUPERVISOR_MAX_RETRIES=2

# Learning Layer (Phase 3)
DATA_AGENT_V2_LEARNING_ENABLED=false
DATA_AGENT_V2_PATTERN_MEMORY_ENABLED=false
DATA_AGENT_V2_AUTO_METRIC_REFINEMENT_ENABLED=false
DATA_AGENT_V2_AUTO_SCHEMA_ENRICHMENT_ENABLED=false

# Advanced Analysis (Phase 4)
# Mode: off=skip all, manual=use individual flags below, auto=determine from intent
DATA_AGENT_V2_ADVANCED_ANALYTICS_MODE=manual
DATA_AGENT_V2_STATISTICAL_ENABLED=false
DATA_AGENT_V2_INSIGHT_ENABLED=false
DATA_AGENT_V2_VISUALIZATION_ENABLED=false
DATA_AGENT_V2_SKILL_EXECUTION_ENABLED=false

# Auto-synced kernel / enterprise flags (scripts/sync_env_example_to_docs.py)
KERNEL_RUNTIME_PHASE_TRANSITION_STRICT=false
KERNEL_COGNITIVE_STATE_PERSIST_ENABLED=false
KERNEL_STAGING_PHASE_TRANSITION_STRICT=false
KERNEL_REFINE_REPLAN_ENABLED=true
KERNEL_MEMORY_FABRIC_PRIMARY_ONLY=false
KERNEL_RUNTIME_REPLAY_ENABLED=false
KERNEL_AGENT_RUNTIME_V3_ENABLED=true
# Strategy memory auto-write from learning_hook (default false = shadow/feedback only)
KERNEL_AGENT_LEARNING_AUTO_APPLY=false
KERNEL_AGENT_RUNTIME_V3_STRICT=false
KERNEL_UNIFIED_EVIDENCE_STRICT=false
KERNEL_WEB_INTELLIGENCE_PREFERRED=true

# Auto-synced kernel / enterprise flags (scripts/sync_env_example_to_docs.py)
KERNEL_WORLD_MODEL_CROSS_PROCESS_ENABLED=false

# Auto-synced kernel / enterprise flags (scripts/sync_env_example_to_docs.py)
KERNEL_CAPABILITY_INTELLIGENCE_ENABLED=true
KERNEL_CAPABILITY_EVOLUTION_ENABLED=true
KERNEL_CAPABILITY_EVOLUTION_INTERVAL=10
KERNEL_SELF_OPTIMIZING_RUNTIME_ENABLED=true
KERNEL_SELF_OPTIMIZING_RUNTIME_APPLY=false
KERNEL_CLAIM_GRAPH_ENABLED=true
KERNEL_WEB_COVERAGE_EVALUATOR_ENABLED=true
KERNEL_CAPABILITY_SCORE_RANKING_ENABLED=true
KERNEL_PREDICTIVE_WORLD_ENABLED=true
KERNEL_AUTONOMOUS_GOAL_DISCOVERY_ENABLED=true
KERNEL_AUTONOMOUS_GOAL_COMMIT_ENABLED=false
