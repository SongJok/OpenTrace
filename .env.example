# =============================================================================
# OpenTrace environment template
# Copy this file to .env. Values in this template are development defaults only.
# Never commit .env or place real credentials in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker / PostgreSQL / Redis
# -----------------------------------------------------------------------------
# Development-only password. Replace it outside a local workstation.
POSTGRES_PASSWORD=opentrace-dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:opentrace-dev@postgres:5432/opentrace_v2
TOKEN_DB_URL=postgresql://postgres:opentrace-dev@postgres:5432/opentrace_v2
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_TIMEOUT=30
POOL_RECYCLE=1800

REDIS_URL=redis://redis:6379/10
REDIS_PORT=6380
REDIS_SESSION_DB=10
REDIS_CACHE_DB=11
REDIS_MEMORY_DB=12
REDIS_QUEUE_DB=13
REDIS_RATE_LIMIT_DB=14
REDIS_PUBSUB_DB=15

# -----------------------------------------------------------------------------
# Application and security
# -----------------------------------------------------------------------------
APP_NAME=opentrace
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=14100
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=14100
FRONTEND_PORT=14108
DEBUG=false

# Required for staging/production. Generate independent random values, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
JWT_SECRET=
DATA_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ALLOWED_ORIGINS=http://localhost:14108,http://127.0.0.1:14108
DYNAMIC_LLM_ALLOW_PRIVATE_BASE_URLS=false

# Only required when ENTERPRISE_TENANT_RLS_ENABLED=true.
TRUSTED_TENANT_HEADER_SECRET=
TRUSTED_TENANT_HEADER_MAX_AGE_SECONDS=300

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:14100
VITE_WS_URL=ws://localhost:14100

# -----------------------------------------------------------------------------
# Authentication, registration and email
# -----------------------------------------------------------------------------
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_EMAIL_DOMAIN=example.com
ADMIN_EMAIL=admin@example.com
PASSWORD_PREFIX=
DEV_REGISTRATION_AUTO_ACTIVATE=true
DEV_SEED_USER_ENABLED=true
DEV_SEED_USER_EMAIL=dev@example.com
# Development-only seed password. Replace or disable the seed user elsewhere.
DEV_SEED_USER_PASSWORD=opentrace123

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# TLS mode is inferred from port 465/587. Uncomment at most one explicit override if needed.
# SMTP_USE_TLS=true
# SMTP_START_TLS=true
SMTP_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# LLM gateway (OpenAI-compatible endpoint; Qwen/DashScope defaults shown)
# -----------------------------------------------------------------------------
# Optional shared key used by embedding/rerank. Model roles use their own *_API_KEY.
DASHSCOPE_API_KEY=

DEFAULT_LLM_QUERY_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_QUERY_MODEL=qwen3.7-max
DEFAULT_LLM_QUERY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_QUERY_API_KEY=
DEFAULT_LLM_FAST_MODEL=qwen3-8b
DEFAULT_LLM_DEEP_MODEL=qwen3.7-max
DEFAULT_LLM_OMNI_MODEL=qwen3.5-omni-flash

DEFAULT_LLM_COMPRESS_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_COMPRESS_MODEL=qwen3.6-plus
DEFAULT_LLM_COMPRESS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_COMPRESS_API_KEY=

# PLANING is the historic environment-variable spelling retained for compatibility.
DEFAULT_LLM_PLANING_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_PLANING_MODEL=qwen3.6-plus
DEFAULT_LLM_PLANING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_PLANING_API_KEY=

DEFAULT_LLM_SENIORSHORT_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_SENIORSHORT_MODEL=qwen3.6-plus
DEFAULT_LLM_SENIORSHORT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_SENIORSHORT_API_KEY=

DEFAULT_LLM_MIDDLESHORT_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_MIDDLESHORT_MODEL=qwen3-8b
DEFAULT_LLM_MIDDLESHORT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MIDDLESHORT_API_KEY=

DEFAULT_LLM_JUNIORSHORT_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_JUNIORSHORT_MODEL=qwen3-1.7b
DEFAULT_LLM_JUNIORSHORT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_JUNIORSHORT_API_KEY=

DEFAULT_LLM_MINSHORT_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_MINSHORT_MODEL=qwen3-0.6b
DEFAULT_LLM_MINSHORT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MINSHORT_API_KEY=

DEFAULT_LLM_VISION_PROVIDER=阿里巴巴Qwen(DashScope)
DEFAULT_LLM_VISION_MODEL=qwen3.6-vl-plus
DEFAULT_LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_VISION_API_KEY=

# Optional third-party OpenAI-compatible relay. The relay is inactive until a
# user selects "第三方中转站" in Settings. Never commit a real API key here.
OTHER_LLM_MINSHORT_PROVIDER=第三方中转站(OpenAI Compatible)
OTHER_LLM_MINSHORT_BASE_URL=
OTHER_LLM_MINSHORT_API_KEY=
OTHER_LLM_MINSHORT_API_MODE=chat_completions
OTHER_LLM_MODEL1=
OTHER_LLM_MODEL2=

# Shared free model source shown to every user. Keep the real key only in the
# deployed .env file; it must never be committed.
FREE_LLM_MINSHORT_PROVIDER=通用免费模型
FREE_LLM_MINSHORT_BASE_URL=https://coding-api-3671.underpinetree.com
FREE_LLM_MINSHORT_API_KEY=
FREE_LLM_MINSHORT_API_MODE=chat_completions
FREE_LLM_MODEL1=glm-5.2-free
FREE_LLM_MODEL2=deepseek-v4-pro-free

# -----------------------------------------------------------------------------
# Embedding, rerank, RAG and knowledge
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_DIMS=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_PATHS=/embeddings,/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_TRUST_ENV=true
EMBEDDING_SKIP_PROXY_FIRST=true

# Set RERANK_PROVIDER=heuristic and leave URL/key empty for the local fallback.
RERANK_PROVIDER=heuristic
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_API_URL=
RERANK_API_PATHS=/rerank,/v1/rerank
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=10
RERANK_TRUST_ENV=true
RERANK_SKIP_PROXY_FIRST=true

USE_PGVECTOR=true
RAG_MIN_EVIDENCE_SCORE=0.65
RAG_AUTO_FALLBACK_TO_WEB=false
RAG_RERANK_ENABLED=true
RAG_CLAIM_ANCHOR_ENABLED=true
RAG_EVIDENCE_CLUSTER_ENABLED=true
RAG_RRF_FUSION_ENABLED=true
RAG_RRF_K=60

KNOWLEDGE_ORCHESTRATION_ENABLED=true
KNOWLEDGE_QUERY_ENABLED=true
KNOWLEDGE_AUTO_COMPILE_ENABLED=true
KNOWLEDGE_AUTO_PUBLISH=true
KNOWLEDGE_MAX_RELATION_HOPS=2
KNOWLEDGE_QUERY_CANDIDATE_BUDGET=60
KNOWLEDGE_STALE_AFTER_DAYS=30
KNOWLEDGE_JOB_POLL_SECONDS=2
KNOWLEDGE_JOB_RECLAIM_MINUTES=10
KNOWLEDGE_RECONCILE_SECONDS=300

LLMWIKI_ENABLED=true
LLMWIKI_MODEL=qwen3.5-27b
LLMWIKI_TOP_K=3

# -----------------------------------------------------------------------------
# Responses Agent Loop and Agent runtime
# -----------------------------------------------------------------------------
MAX_AGENT_STEPS=8
AGENT_TIMEOUT=120
# 新部署只选择一个能力组合；细粒度 KERNEL_AGENT_* 仅保留代码兼容。
CAPABILITY_PROFILE=data_knowledge
KERNEL_AGENT_ENABLED=true
KERNEL_AGENT_TIMEOUT_SEC=30
KERNEL_AGENT_MAX_PARALLEL=5
KERNEL_AGENT_MAX_RETRY=1
KERNEL_AGENT_RUNTIME_SUPERVISOR_ENABLED=true
KERNEL_ALL_QUESTIONS_REQUIRE_MODEL=true
KERNEL_ANSWER_DRAFT_CONFIDENCE_THRESHOLD=0.75
KERNEL_ANSWER_DRAFT_MAX_CHARS=220
KERNEL_ADAPTIVE_MODE_ENABLED=true
KERNEL_ADAPTIVE_PROFILE_JSON=
KERNEL_PLAN_MEMORY_ENABLED=true
KERNEL_PLAN_MEMORY_WINDOW=50
KERNEL_MEMORY_CONTEXT_ENABLED=true
KERNEL_ENRICHED_IDENTITY_ENABLED=true

RESPONSES_CONTEXT_WINDOW_TOKENS=131072
RESPONSES_CONTEXT_OUTPUT_RESERVE_TOKENS=8192
RESPONSES_SUMMARY_TRIGGER_TOKENS=48000
RESPONSES_CAPABILITY_CATALOG_LIMIT=48
RESPONSES_AGENT_DEEP_MAX_ROUNDS=16
RESPONSES_AGENT_REPLAN_LIMIT=3
RESPONSES_DATA_KNOWLEDGE_CONTEXT_MAX_CHARS=12000
RESPONSE_WORKER_POLL_SECONDS=2
RESPONSE_WORKER_BATCH_SIZE=20
RESPONSE_WORKER_CONCURRENCY=4
RESPONSE_WORKER_MAX_QUEUE_DEPTH=1000
RESPONSE_WORKER_TENANT_CONCURRENCY=2
# all | responses | agents | knowledge | scheduler
WORKER_ROLE=all
WORKER_METRICS_PORT=9464

# Skills 本地镜像：Knowledge Worker 启动时仅在镜像为空时补齐，并在 Asia/Shanghai 每天 06:30 更新。
SKILLHUB_SYNC_ENABLED=true
SKILLHUB_SYNC_INTERVAL_SECONDS=86400
SKILLHUB_SYNC_HOUR=6
SKILLHUB_SYNC_MINUTE=30
SKILLHUB_SYNC_TIMEZONE=Asia/Shanghai
SKILLHUB_SYNC_RETRY_SECONDS=60
SKILLHUB_SYNC_DOWNLOAD_CONCURRENCY=8
SKILLHUB_LOCAL_MIRROR_DIR=skills/catalog_mirror
SKILLHUB_CATALOG_SIZE=30
SKILLHUB_MIN_SECURITY_SCORE=80
SKILLHUB_CATALOG_URL=https://skills.palebluedot.live
# 可选，仅用于后台同步阶段读取 GitHub；用户安装不会访问外网。
SKILLHUB_GITHUB_TOKEN=
SKILLHUB_GITHUB_TIMEOUT_SECONDS=20
SKILLHUB_GITHUB_RAW_FALLBACK_ENABLED=true

KERNEL_AGENT_BUS_ENABLED=true
KERNEL_AGENT_BUS_REQUIRE_WORKER=true
KERNEL_AGENT_BUS_NAMESPACE=opentrace:agent
KERNEL_AGENT_BUS_MODE=pubsub
KERNEL_AGENT_BUS_GROUP=agent-workers
KERNEL_AGENT_BUS_CONSUMER=worker-1
KERNEL_AGENT_BUS_RECLAIM_IDLE_MS=30000
KERNEL_AGENT_BUS_RECLAIM_COUNT=20
KERNEL_AGENT_BUS_MAX_RETRY=2
KERNEL_AGENT_BUS_DLQ_STREAM=opentrace:agent:stream:dlq

# Registry-governed runtime flags. Keep these documented for CI/config contracts.
KERNEL_RUNTIME_PHASE_TRANSITION_STRICT=true
KERNEL_MEMORY_FABRIC_PRIMARY_ONLY=false
KERNEL_RUNTIME_REPLAY_ENABLED=false
KERNEL_AGENT_LEARNING_AUTO_APPLY=false


# -----------------------------------------------------------------------------
# Enterprise controls
# -----------------------------------------------------------------------------
ENTERPRISE_QUOTA_REDIS_ENABLED=false
ENTERPRISE_USAGE_REDIS_ENABLED=false
ENTERPRISE_TENANT_RLS_ENABLED=false
ENTERPRISE_BILLING_PERSIST_ENABLED=false
ENTERPRISE_BILLING_PROMPT_PER_MILLION=0.15
ENTERPRISE_BILLING_COMPLETION_PER_MILLION=0.60
ENTERPRISE_DEFAULT_RETENTION_DAYS=365
ENTERPRISE_DELETION_GRACE_DAYS=7
DATA_DELETION_POLL_SECONDS=60
ENTERPRISE_TOKEN_REVOCATION_ENABLED=true
IDENTITY_OIDC_ENABLED=false
IDENTITY_OIDC_ISSUER=
IDENTITY_OIDC_AUDIENCE=
IDENTITY_OIDC_JWKS_URL=
IDENTITY_OIDC_ALGORITHMS=RS256,ES256
# -----------------------------------------------------------------------------
# DataAgent 企业问数平台
# -----------------------------------------------------------------------------
DATA_AGENT_ENABLED=true
DATA_AGENT_MAX_RETRY=2
DATA_AGENT_DEFAULT_LIMIT=100
DATA_AGENT_MAX_RESULT_ROWS=500
DATA_AGENT_STATEMENT_TIMEOUT_MS=15000
DATA_AGENT_JOIN_INFERENCE_ENABLED=true
DATA_AGENT_MAX_JOIN_DEPTH=3
DATA_AGENT_GENERATION_MAX_TOKENS=1600
DATA_AGENT_SCHEMA_HINT_MAX_CHARS=16000
DATA_AGENT_PROFILE_ENABLED=true
DATA_AGENT_PROFILE_SAMPLE_ROWS=1000
DATA_AGENT_PROFILE_MAX_TABLES=50
DATA_AGENT_PROFILE_MAX_COLUMNS_PER_TABLE=100
DATA_AGENT_PROFILE_TOP_VALUES=20
DATA_AGENT_PROFILE_STATEMENT_TIMEOUT_MS=30000
DATA_AGENT_PROFILE_TTL_HOURS=24
DATA_AGENT_PREFLIGHT_REQUIRED=true
DATA_AGENT_PREFLIGHT_TIMEOUT_MS=15000
DATA_AGENT_PREFLIGHT_MAX_ESTIMATED_ROWS=10000000
DATA_AGENT_PREFLIGHT_MAX_ESTIMATED_BYTES=1073741824
# Schema 元数据按批次读取；上限是防止错误授权或系统库暴露耗尽 API 内存的安全预算。
DATABASE_SCHEMA_SYNC_PAGE_SIZE=2000
DATABASE_SCHEMA_SYNC_MAX_TABLES=100000
DATABASE_SCHEMA_SYNC_MAX_COLUMNS=1000000
SCHEMA_ANNOTATION_AUTO_SUGGEST_MAX_ITEMS=20000

# -----------------------------------------------------------------------------
# Attachments, Skills and sandbox
# -----------------------------------------------------------------------------
ATTACHMENT_UPLOAD_ENABLED=true
ATTACHMENT_MAX_SIZE_MB=20
ATTACHMENT_STORAGE_PATH=/tmp/opentrace_attachments
# development compatibility only; staging/production must use local or s3.
OBJECT_STORAGE_BACKEND=database
OBJECT_STORAGE_LOCAL_PATH=/var/lib/opentrace/objects
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE=true
ATTACHMENT_MAX_CHARS=4000
MULTIMODAL_ATTACHMENT_ENABLED=true
MULTIMODAL_INLINE_MAX_MB=7

# Dynamic code execution is deliberately disabled by default.
SKILLS_GIT_INSTALL_ENABLED=false
SKILLS_LOCAL_CREATE_ENABLED=false
SKILLS_INPROCESS_EXECUTION_ENABLED=false
SKILLS_SUBPROCESS_EXECUTION_ENABLED=false
SKILLS_EXECUTION_TIMEOUT_SECONDS=10
SANDBOX_PROVIDER=local_ast

# JSON list example:
# [{"canonical_name":"North China","entity_type":"region","aliases":["north"],"mappings":{}}]
COGNITION_LEXICON_JSON=

# -----------------------------------------------------------------------------
# Observability and network
# -----------------------------------------------------------------------------
TRACE_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=opentrace
OTEL_TRACES_SAMPLER=always_on

# Optional proxy configuration. Keep credentials out of committed templates.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,.aliyuncs.com,dashscope.aliyuncs.com

# Optional image/build overrides
OPENTRACE_IMAGE=
PYTHON_BASE_IMAGE=python:3.11-slim
FRONTEND_NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
FRONTEND_NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:alpine
UV_VERSION=0.8.24
# Python 依赖源逐个尝试，不并列访问官方 PyPI，避免国内服务器长时间等待。
PYTHON_DEPENDENCY_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PYTHON_DEPENDENCY_FALLBACK_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PYTHON_DEPENDENCY_PRIMARY_MAX_SECONDS=180
PYTHON_DEPENDENCY_FALLBACK_MAX_SECONDS=1200
PYTHON_DEPENDENCY_HTTP_TIMEOUT=60
PYTHON_DEPENDENCY_HTTP_RETRIES=3
PYTHON_DEPENDENCY_FALLBACK_ATTEMPTS=2
UV_CONCURRENT_DOWNLOADS=4
UV_CONCURRENT_INSTALLS=2
UV_CONCURRENT_BUILDS=1
# uv 安装器同样逐个使用国内镜像；主源失败后会快速切换。
UV_BOOTSTRAP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
UV_BOOTSTRAP_FALLBACK_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_BOOTSTRAP_TIMEOUT=30
UV_BOOTSTRAP_RETRIES=1
UV_BOOTSTRAP_PRIMARY_MAX_SECONDS=90
UV_BOOTSTRAP_FALLBACK_MAX_SECONDS=300
NPM_REGISTRY=https://registry.npmjs.org/

# Auto-synced kernel / enterprise flags (scripts/sync_env_example_to_docs.py)
KERNEL_REGISTRY_DISPATCH_STRICT=true
KERNEL_AGENT_RUNTIME_V3_STRICT=false
